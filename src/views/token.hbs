<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Account Verification</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f4f4f8;
      margin: 0;
      padding: 0;
    }

    .container {
      max-width: 600px;
      margin: 60px auto;
      background-color: #ffffff;
      padding: 40px 30px;
      border-radius: 8px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.05);
      text-align: center;
    }

    h1 {
      color: #333;
    }

    p {
      font-size: 16px;
      color: #555;
      line-height: 1.5;
    }

    a.button {
      display: inline-block;
      margin-top: 20px;
      background-color: #674299;
      color: white;
      text-decoration: none;
      padding: 12px 24px;
      border-radius: 6px;
      font-size: 16px;
      transition: background-color 0.3s ease;
    }

    a.button:hover {
      background-color: #583782;
    }

    .fallback {
      margin-top: 30px;
      font-size: 14px;
      color: #777;
    }

    .fallback code {
      background-color: #f2f2f2;
      padding: 6px 10px;
      display: inline-block;
      word-break: break-all;
      border-radius: 4px;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>Verify Your Account</h1>
    <p>Click the button below to verify your account:</p>
    <a class="button" href="{{token}}">Verify Token</a>

    <div class="fallback">
      <p>If the button above doesn't work, copy and paste this link into your browser:</p>
      <code>{{token}}</code>
    </div>
  </div>
</body>
</html>
