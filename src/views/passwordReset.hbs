<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Your New Account Password</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: #f4f6f9;
      font-family: 'Segoe UI', Tahoma, sans-serif;
    }

    .container {
      max-width: 600px;
      margin: auto;
      background-color: #ffffff;
      padding: 30px;
      border-radius: 8px;
      box-shadow: 0 0 10px rgba(0,0,0,0.05);
    }

    h2 {
      color: #333333;
    }

    p {
      color: #555;
      font-size: 15px;
      line-height: 1.6;
    }

    .password-box {
      display: inline-block;
      background-color: #f0f4f8;
      border: 1px dashed #0077cc;
      color: #000;
      font-size: 16px;
      padding: 10px 16px;
      margin: 20px 0;
      border-radius: 6px;
      font-weight: bold;
    }

    .btn {
      display: inline-block;
      padding: 12px 20px;
      background-color: #0077cc;
      color: white;
      text-decoration: none;
      border-radius: 6px;
      font-weight: bold;
      margin-top: 10px;
    }

    .btn:hover {
      background-color: #005fa3;
    }

    .footer {
      font-size: 12px;
      color: #888;
      text-align: center;
      margin-top: 30px;
    }
  </style>
</head>
<body>
  <div class="container">
    <h2>Welcome, {{first_name}} 👋</h2>
    <p>
      Your {{role}} account has been created. Below is your temporary password:
    </p>

    <div class="password-box">{{password}}</div>

    <p>
      Please <strong>log in</strong> using the password above and change it immediately for security.
    </p>

    <p style="text-align: center;">
      <a href="{{login_url}}" class="btn">Log In Now</a>
    </p>

    <p>
      If you didn’t expect this email, you can safely ignore it or contact support.
    </p>

    <div class="footer">
      &copy; {{year}} Your Company Name. All rights reserved.
    </div>
  </div>
</body>
</html>
